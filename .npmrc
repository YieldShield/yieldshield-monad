# @solana-program/token-2022@0.7 declares a peer of @solana/kit@^5, but the app is on kit@6.
# The packages are compatible in practice; without this, a clean `npm install` (e.g. on Vercel/CI)
# fails ERESOLVE. Locally this was only masked by a global ~/.npmrc legacy-peer-deps setting.
legacy-peer-deps=true
