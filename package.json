{
  "name": "yieldshield-monad",
  "private": true,
  "version": "0.1.0",
  "description": "YieldShield on Monad: protected crypto positions and first-loss liquidity for Metropolis.",
  "workspaces": [
    "apps/monad-web"
  ],
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "scripts": {
    "build": "npm run build -w monad-web",
    "test:web": "npm run test -w monad-web",
    "typecheck": "npm run typecheck -w monad-web",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev": "npm run dev -w monad-web",
    "start:api": "node services/monad/server.mjs",
    "test:monad": "node --test services/monad/*.test.mjs scripts/monad-deployment.test.mjs scripts/monad-receipts.test.mjs scripts/generate-monad-abis.test.mjs",
    "sync:monad": "node scripts/sync-monad.mjs",
    "deploy:monad:prepare": "node scripts/deploy-monad.mjs --prepare",
    "deploy:monad": "node scripts/deploy-monad.mjs --broadcast",
    "deploy:reference": "node scripts/deploy-monad-redstone-reference.mjs --broadcast",
    "verify:monad": "node scripts/verify-monad.mjs",
    "smoke:monad": "node scripts/smoke-monad.mjs --broadcast",
    "smoke:reference": "node scripts/smoke-monad.mjs --broadcast --reference",
    "check:scope": "node --test scripts/check-monad-scope.test.mjs && node scripts/check-monad-scope.mjs",
    "lint:web": "eslint apps/monad-web/src",
    "generate:abis": "node scripts/generate-monad-abis.mjs"
  },
  "dependencies": {
    "@dynamic-labs/ethereum": "5.12.0",
    "@dynamic-labs/ethereum-core": "5.12.0",
    "@dynamic-labs/sdk-react-core": "5.12.0",
    "@dynamic-labs/wallet-connector-core": "5.12.0",
    "@pythnetwork/pyth-sdk-solidity": "4.3.1",
    "viem": "^2.57.7",
    "bigint-buffer": "file:vendor/bigint-buffer"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.4"
  },
  "overrides": {
    "axios@1.16.0": "1.20.0",
    "sharp@>=0.35.0 <0.35.5": "0.35.5",
    "uuid@>=8 <11.1.1": "11.1.1",
    "jayson@4.3.0": "5.0.0",
    "bigint-buffer": "$bigint-buffer",
    "ws@>=8.0.0 <8.21.0": "8.21.0",
    "query-string@7.1.3": "8.2.0",
    "decode-uri-component@<=0.4.2": "0.5.1",
    "zod@<4.6.6": "4.6.7"
  }
}
