{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "apps/monad-web/dist",
  "installCommand": "npm ci --ignore-scripts",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://monad-api.yieldshield.ai/api/:path*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/evidence",
      "destination": "/how-it-works",
      "permanent": true
    },
    {
      "source": "/media/metropolis-overview.mp4",
      "destination": "/media/how-it-works-20260916.mp4",
      "permanent": true
    },
    {
      "source": "/media/metropolis-overview.vtt",
      "destination": "/media/how-it-works-20260916.vtt",
      "permanent": true
    },
    {
      "source": "/media/metropolis-overview.txt",
      "destination": "/media/how-it-works-20260916.txt",
      "permanent": true
    }
  ]
}
