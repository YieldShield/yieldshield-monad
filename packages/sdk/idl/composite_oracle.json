    {
      "name": "FeedConfig",
      "docs": [
        "Per-token feed configuration — PDA seeds `[\"feed\", token_mint]` (oracle REQ-002..004).",
        "",
        "Carries the primary slot, an optional backup slot, the dual-feed challenge state, and the",
        "per-token safety parameters. Protected reads fail closed while a challenge is pending or a",
        "dispute is unresolved (oracle SEC-001)."
      ],
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "token_mint",
            "docs": [
              "The token this feed prices."
            ],
            "type": "pubkey"
          },
          {
            "name": "primary",
            "docs": [
              "Primary feed slot."
            ],
            "type": {
              "defined": {
                "name": "FeedSlot"
              }
            }
          },
          {
            "name": "backup",
            "docs": [
              "Optional backup feed slot (dual-feed); `None` = single-feed token."
            ],
            "type": {
              "option": {
                "defined": {
                  "name": "FeedSlot"
                }
              }
            }
          },
          {
            "name": "is_backup_active",
            "docs": [
              "True once a finalized challenge has switched routing to the backup (AC-003)."
            ],
            "type": "bool"
          },
          {
            "name": "challenge_start",
            "docs": [
              "Active-challenge start time; `0` when no challenge is in flight."
            ],
            "type": "i64"
          },
          {
            "name": "challenger",
            "docs": [
              "Address that opened the active challenge; `None` when idle."
            ],
            "type": {
              "option": "pubkey"
            }
          },
          {
            "name": "last_challenge_time",
            "docs": [
              "Last challenge timestamp (enforces `COOLDOWN_PERIOD`, CON-002)."
            ],
            "type": "i64"
          },
          {
            "name": "requires_strict",
            "docs": [
              "True if this token must use the strict protected-price path (SEC-006)."
            ],
            "type": "bool"
          },
          {
            "name": "max_price_age",
            "docs": [
              "Per-token staleness window (seconds), bounded by `MAX_PRICE_AGE_LIMIT`."
            ],
            "type": "u64"
          },
          {
            "name": "max_confidence_bps",
            "docs": [
              "Per-token max confidence width (bps)."
            ],
            "type": "u64"
          },
          {
            "name": "max_deviation_bps",
            "docs": [
              "Per-token deviation circuit-breaker threshold (bps)."
            ],
            "type": "u64"
          },
          {
            "name": "primary_price",
            "docs": [
              "Cached primary price (USD 8-decimal) for `Manual` slots; `0` until first push."
            ],
            "type": "u128"
          },
          {
            "name": "primary_publish_time",
