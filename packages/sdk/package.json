{
  "name": "@yieldshield/sdk",
  "version": "0.1.0",
  "description": "Framework-agnostic, headless on-chain SDK for the YieldShield split-risk protocol. The only layer that talks to chain.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "idl",
    "src"
  ],
  "sideEffects": false,
  "scripts": {
    "codegen": "tsx scripts/codegen.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@solana-program/system": "^0.12.2",
    "@solana-program/token": "^0.14.0",
    "@solana/kit": "^6.10.0",
    "@solana/program-client-core": "^6.10.0",
    "@yieldshield/core": "*"
  },
  "devDependencies": {
    "@codama/nodes-from-anchor": "^1.5.1",
    "@codama/renderers-js": "^2.3.0",
    "@types/node": "^22.10.0",
    "codama": "^1.8.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
