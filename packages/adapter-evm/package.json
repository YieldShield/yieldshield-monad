{
  "name": "@yieldshield/adapter-evm",
  "version": "0.1.0",
  "description": "EVM implementation of the @yieldshield/core chain port: reads via viem multicall against the SplitRiskPool contracts, tx intents to approve+call sequences, and the wagmi wallet/submit React surface.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.11",
    "@wagmi/core": "^3.0.0",
    "@yieldshield/core": "*",
    "viem": "^2.40.3",
    "wagmi": "^3.1.0"
  },
  "peerDependencies": {
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "typescript": "^5.7.2"
  }
}
