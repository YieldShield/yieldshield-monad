FROM node:24-bookworm-slim
WORKDIR /app
COPY services/package.json services/package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts && npm cache clean --force
COPY services ./services
COPY contracts/deployments/base-sepolia-alpha.json ./contracts/deployments/base-sepolia-alpha.json
COPY contracts/deployments/base-sepolia-demo-v1.json ./contracts/deployments/base-sepolia-demo-v1.json
COPY contracts/deployments/base-sepolia-crypto-v1.json ./contracts/deployments/base-sepolia-crypto-v1.json
ENV NODE_ENV=production
ENV PORT=3001
USER node
EXPOSE 3001
CMD ["node", "services/base-api.mjs"]
